generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TripPlan {
  id            String    @id @default(uuid())
  userId        String
  city          String
  days          Int
  preferences   String[]
  plan          Json
  tripStartDate DateTime? @db.Date
  tripEndDate   DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([userId, city])
}
