{
  "openapi": "3.0.3",
  "info": {
    "title": "Rihla backend APIs",
    "description": "OpenAPI documentation. Friends service runs on port 4003 (host) or `friends:4003` inside Docker Compose.\n\n**WebSocket chat** (port 8181 by default) is in `friends-chat.asyncapi.yaml`. **Notification WebSocket** (port 8182 by default) is in `friends-notifications.asyncapi.yaml`. Open either file from this folder in [AsyncAPI Studio](https://studio.asyncapi.com/) (File → Load file), or mount the same directory in any AsyncAPI viewer.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:4003",
      "description": "Friends service (local)"
    },
    {
      "url": "http://friends:4003",
      "description": "Friends service (Docker network `saas`)"
    }
  ],
  "tags": [
    {
      "name": "Friends",
      "description": "Friend requests and friendships (friends-service)"
    },
    {
      "name": "Chat",
      "description": "Direct messages between friends (friends-service, `/chat`)"
    },
    {
      "name": "Notifications",
      "description": "In-app notifications (friends-service, `/notifications`); real-time delivery on WebSocket port 8182"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token from auth-service (same as fav-places / profiles)"
      }
    },
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "example": false },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      },
      "Friend": {
        "type": "object",
        "description": "Frontend-friendly shape; display fields may be enriched later via profiles-service.",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "isOnline": { "type": "boolean" },
          "username": { "type": "string", "nullable": true },
          "email": { "type": "string", "nullable": true },
          "bio": { "type": "string", "nullable": true },
          "status": { "type": "string", "nullable": true, "example": "offline" }
        },
        "required": ["id", "name", "isOnline"]
      },
      "FriendRequest": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "fromUserId": { "type": "string" },
          "toUserId": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "fromUserId", "toUserId", "createdAt", "updatedAt"]
      },
      "SendFriendRequestBody": {
        "type": "object",
        "required": ["toUserId"],
        "properties": {
          "toUserId": {
            "type": "string",
            "description": "Target user id (JWT `sub` / auth user id)"
          }
        }
      },
      "SendFriendRequestResult": {
        "type": "object",
        "properties": {
          "autoAccepted": { "type": "boolean" },
          "request": { "$ref": "#/components/schemas/FriendRequest" },
          "friendship": {
            "type": "object",
            "properties": {
              "userLowId": { "type": "string" },
              "userHighId": { "type": "string" }
            }
          }
        }
      },
      "OkEnvelope": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "example": true },
          "data": {}
        },
        "required": ["ok", "data"]
      },
      "ChatLastMessage": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "senderId": { "type": "string" },
          "content": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "senderId", "content", "createdAt"]
      },
      "ChatConversationSummary": {
        "type": "object",
        "description": "One row per conversation; for 1:1 DMs `peerUserId` is the other user.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "createdAt": { "type": "string", "format": "date-time" },
          "peerUserId": { "type": "string", "nullable": true },
          "participantCount": { "type": "integer" },
          "lastMessage": {
            "nullable": true,
            "allOf": [{ "$ref": "#/components/schemas/ChatLastMessage" }]
          }
        },
        "required": ["id", "createdAt", "participantCount"]
      },
      "OpenDmBody": {
        "type": "object",
        "required": ["withUserId"],
        "properties": {
          "withUserId": {
            "type": "string",
            "description": "Friend's user id (must be an existing friendship)"
          }
        }
      },
      "OpenDmResult": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "createdAt": { "type": "string", "format": "date-time" },
          "peerUserId": { "type": "string" },
          "participantCount": { "type": "integer" }
        },
        "required": ["id", "createdAt", "peerUserId", "participantCount"]
      },
      "ChatMessage": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "conversationId": { "type": "string", "format": "uuid" },
          "senderId": { "type": "string" },
          "content": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "conversationId", "senderId", "content", "createdAt"]
      },
      "MessagesPage": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ChatMessage" }
          },
          "hasMore": { "type": "boolean" }
        },
        "required": ["messages", "hasMore"]
      },
      "SendMessageBody": {
        "type": "object",
        "required": ["content"],
        "properties": {
          "content": {
            "type": "string",
            "description": "Message body (trimmed; max length enforced server-side)"
          }
        }
      },
      "Notification": {
        "type": "object",
        "description": "Persisted row; `GET /notifications` omits archived notifications.",
        "properties": {
          "id": { "type": "string", "description": "Cuid" },
          "userId": { "type": "string" },
          "type": {
            "type": "string",
            "description": "Aligned with `NOTIFY_TYPES` in friends-service (`utils/notifications.js`).",
            "enum": [
              "FRIEND_REQUEST_RECEIVED",
              "FRIEND_REQUEST_ACCEPTED",
              "FRIENDSHIP_CREATED",
              "CHAT_MESSAGE"
            ]
          },
          "title": { "type": "string", "nullable": true },
          "body": { "type": "string", "nullable": true },
          "data": {
            "type": "object",
            "additionalProperties": true,
            "nullable": true,
            "description": "Optional JSON payload (e.g. conversation id for chat)"
          },
          "read": { "type": "boolean" },
          "readAt": { "type": "string", "format": "date-time", "nullable": true },
          "archived": { "type": "boolean" },
          "archivedAt": { "type": "string", "format": "date-time", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "userId", "type", "read", "archived", "createdAt"]
      },
      "ReadAllNotificationsResult": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "description": "Rows updated from unread to read (non-archived only)"
          }
        },
        "required": ["count"]
      }
    }
  },
  "paths": {
    "/friends": {
      "get": {
        "tags": ["Friends"],
        "summary": "List friends",
        "description": "Returns friends of the authenticated user.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Array of friends",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/OkEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Friend" }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          }
        }
      }
    },
    "/friends/{userId}": {
      "get": {
        "tags": ["Friends"],
        "summary": "Get one friend",
        "description": "Only succeeds if `userId` is an actual friend.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Friend profile stub",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/OkEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/Friend" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not friends",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Friends"],
        "summary": "Remove friend",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Friendship removed" },
          "404": {
            "description": "No friendship with this user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          }
        }
      }
    },
    "/friends/requests/incoming": {
      "get": {
        "tags": ["Friends"],
        "summary": "List incoming friend requests",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Pending requests where you are the recipient",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/OkEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/FriendRequest" }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          }
        }
      }
    },
    "/friends/requests/outgoing": {
      "get": {
        "tags": ["Friends"],
        "summary": "List outgoing friend requests",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Pending requests you sent",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/OkEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/FriendRequest" }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          }
        }
      }
    },
    "/friends/requests": {
      "post": {
        "tags": ["Friends"],
        "summary": "Send friend request",
        "description": "If the other user already sent you a request, the friendship is created immediately (auto-accept).",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendFriendRequestBody" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request created or friendship auto-created",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/OkEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/SendFriendRequestResult"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid body",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "409": {
            "description": "Already friends or duplicate pending request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          }
        }
      }
    },
    "/friends/requests/{requestId}/accept": {
      "post": {
        "tags": ["Friends"],
        "summary": "Accept friend request",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Accepted; friendship created" },
          "403": {
            "description": "Not the recipient of this request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "404": {
            "description": "Request not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          }
        }
      }
    },
    "/friends/requests/{requestId}": {
      "delete": {
        "tags": ["Friends"],
        "summary": "Cancel or decline friend request",
        "description": "Sender can cancel; recipient can decline.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Request removed" },
          "403": {
            "description": "Not involved in this request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "404": {
            "description": "Request not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          }
        }
      }
    },
    "/chat/conversations": {
      "get": {
        "tags": ["Chat"],
        "summary": "List my conversations",
        "description": "Conversations the authenticated user participates in, sorted by recent activity.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Conversation summaries",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/OkEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/ChatConversationSummary" }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Chat"],
        "summary": "Open or create DM with a friend",
        "description": "Returns existing 1:1 conversation if one already exists; otherwise creates it. Fails with 403 if `withUserId` is not a friend.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OpenDmBody" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Conversation id and metadata",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/OkEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/OpenDmResult" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid body or self-DM",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "403": {
            "description": "Not friends (`NOT_FRIEND`)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          }
        }
      }
    },
    "/chat/conversations/{conversationId}/messages": {
      "get": {
        "tags": ["Chat"],
        "summary": "List messages in a conversation",
        "description": "Default page is the most recent messages (chronological in `data.messages`). Use query `before` with a message id to load older pages.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Message id cursor; return older messages than this one"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
          }
        ],
        "responses": {
          "200": {
            "description": "Message page",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/OkEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/MessagesPage" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid `before` cursor",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "404": {
            "description": "Not a participant (`NOT_FOUND`)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Chat"],
        "summary": "Send a message",
        "description": "Persists the message, broadcasts to chat WebSocket participants, and enqueues in-app notifications for other participants.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendMessageBody" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created message (returned as `data`)",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/OkEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/ChatMessage" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Empty or too long content",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "404": {
            "description": "Not a participant",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          }
        }
      }
    },
    "/notifications": {
      "get": {
        "tags": ["Notifications"],
        "summary": "List notifications",
        "description": "Returns non-archived notifications for the authenticated user, newest first.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Notification list in `data`",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/OkEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Notification" }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          }
        }
      }
    },
    "/notifications/read": {
      "patch": {
        "tags": ["Notifications"],
        "summary": "Mark one notification read",
        "description": "Requires query `id` (notification id). Only affects rows owned by the caller that are not archived.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Notification id"
          }
        ],
        "responses": {
          "200": {
            "description": "Updated notification in `data`",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/OkEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/Notification" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Missing or empty `id` (`INVALID_INPUT`)",
            "content": {
              "application/json": {
